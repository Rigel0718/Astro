---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const seriesPrefix = "python/understanding-python-objects/";
const posts = getSortedPosts(await getCollection("posts")).filter(post =>
  post.id.startsWith(seriesPrefix),
);
const seriesUrl = getRelativeLocaleUrl(
  locale,
  "posts/python/understanding-python-objects",
);
---

<Layout
  title={`Python | ${config.site.title}`}
  description="Python 학습 시리즈와 에피소드를 모아 보는 공간입니다."
>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle="Python"
    pageDesc="Python을 공부하며 정리한 주제별 에피소드를 모았습니다."
  >
    <section aria-labelledby="python-series-title" class="mt-8">
      <h2 id="python-series-title" class="sr-only">Python 시리즈</h2>
      <a
        href={seriesUrl}
        class="focus-outline border-border hover:border-accent group block rounded-lg border p-6 transition-colors sm:p-8"
      >
        <div class="mb-4 flex items-center justify-between gap-4">
          <span
            class="bg-accent/10 text-accent rounded-full px-3 py-1 text-sm font-medium"
          >
            Python · {posts.length}/8
          </span>
          <IconArrowRight
            aria-hidden="true"
            class="text-accent size-6 transition-transform group-hover:translate-x-1 rtl:-rotate-180"
          />
        </div>
        <h3 class="text-accent text-xl font-semibold sm:text-2xl">
          파이썬 객체에 대한 이해
        </h3>
        <p class="mt-3 text-sm leading-7 sm:text-base">
          이름과 값, 가변성과 불변성, 복사와 참조까지 파이썬 객체를 이해하는 데
          필요한 개념을 8개의 에피소드로 정리합니다.
        </p>
      </a>
    </section>
  </Main>

  <Footer />
</Layout>
