---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";
import { POST_TOPICS } from "@/config/postTopics";

const locale = Astro.currentLocale ?? config.site.lang;
const pythonTopic = POST_TOPICS.python;
const seriesPrefix = "python/understanding-python-objects/";
const posts = getSortedPosts(await getCollection("posts")).filter(post =>
  post.id.startsWith(seriesPrefix),
);
const seriesUrl = getRelativeLocaleUrl(
  locale,
  "posts/python/understanding-python-objects",
);
---

<Layout
  title={`${pythonTopic.title} | ${config.site.title}`}
  description={pythonTopic.description}
>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle={pythonTopic.title}
    pageDesc={pythonTopic.description}
  >
    <section aria-labelledby="python-series-title" class="mt-8">
      <h2 id="python-series-title" class="sr-only">Python 시리즈</h2>
      <a
        href={seriesUrl}
        class="focus-outline border-border hover:border-accent group block rounded-lg border p-6 transition-colors sm:p-8"
      >
        <div class="mb-4 flex items-center justify-between gap-4">
          <span
            class="bg-accent/10 text-accent rounded-full px-3 py-1 text-sm font-medium"
          >
            Python · {posts.length}/8
          </span>
          <IconArrowRight
            aria-hidden="true"
            class="text-accent size-6 transition-transform group-hover:translate-x-1 rtl:-rotate-180"
          />
        </div>
        <h3 class="text-accent text-xl font-semibold sm:text-2xl">
          파이썬 객체에 대한 이해
        </h3>
        <p class="mt-3 text-sm leading-7 sm:text-base">
          Python에서 객체란 무엇이고, 실제로 어떻게 동작할까?
          변수와 객체의 관계부터 메모리, Attribute 탐색, 상속과 객체의 생명주기까지 차근차근 살펴봅니다.
        </p>
      </a>
    </section>
  </Main>

  <Footer />
</Layout>
