---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const seriesPrefix = "python/understanding-python-objects/";
const episodeCount = 8;
const posts = getSortedPosts(await getCollection("posts"))
  .filter(post => post.id.startsWith(seriesPrefix))
  .sort((a, b) => a.id.localeCompare(b.id, "en", { numeric: true }));
---

<Layout
  title={`파이썬 객체에 대한 이해 | ${config.site.title}`}
  description="파이썬 객체의 핵심 개념을 순서대로 살펴보는 8개 에피소드 시리즈입니다."
>
  <Header />
  <Breadcrumb />

  <Main
    pageTitle="파이썬 객체에 대한 이해"
    pageDesc="파이썬의 모든 값이 객체라는 출발점부터 객체의 동작을 차근차근 살펴봅니다."
  >
    <div class="border-border mb-8 border-y py-5">
      <div class="mb-2 flex items-center justify-between text-sm">
        <span>시리즈 진행률</span>
        <span class="text-accent font-medium"
          >{posts.length} / {episodeCount}</span
        >
      </div>
      <div
        class="bg-muted h-2 overflow-hidden rounded-full"
        role="progressbar"
        aria-label="게시된 에피소드"
        aria-valuemin="0"
        aria-valuemax={episodeCount}
        aria-valuenow={posts.length}
      >
        <div
          class="bg-accent h-full rounded-full transition-all"
          style={`width: ${(posts.length / episodeCount) * 100}%`}
        >
        </div>
      </div>
    </div>

    <ol class="space-y-3" aria-label="에피소드 목록">
      {
        Array.from({ length: episodeCount }, (_, index) => {
          const post = posts[index];
          const episodeNumber = String(index + 1).padStart(2, "0");

          return (
            <li class="border-border rounded-lg border p-5 sm:p-6">
              <div class="flex gap-4">
                <span
                  class="text-accent text-sm font-semibold"
                  aria-hidden="true"
                >
                  {episodeNumber}
                </span>
                <div class="min-w-0 flex-1">
                  {post ? (
                    <>
                      <a
                        href={getPostUrl(post.id, post.filePath, locale)}
                        class="text-accent focus-outline inline-block text-lg font-semibold decoration-dashed underline-offset-4 hover:underline"
                      >
                        {post.data.title}
                      </a>
                      <Datetime {...post.data} />
                      <p class="mt-2 text-sm leading-6">
                        {post.data.description}
                      </p>
                    </>
                  ) : (
                    <>
                      <p class="font-medium">에피소드 {index + 1}</p>
                      <p class="text-muted-foreground mt-1 text-sm">준비 중</p>
                    </>
                  )}
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>
  </Main>

  <Footer />
</Layout>
