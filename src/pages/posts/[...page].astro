---
import type { GetStaticPaths } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

export const getStaticPaths = (async ({ paginate }) => {
  return paginate([], { pageSize: config.posts.perPage });
}) satisfies GetStaticPaths;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const pythonUrl = getRelativeLocaleUrl(locale, "posts/python");
---

<Layout title={`${t.pages.postsTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.postsTitle} pageDesc={t.pages.postsDesc}>
    <ul>
      <li class="my-6">
        <a
          href={pythonUrl}
          class="text-accent focus-outline inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline"
        >
          <h2>Python</h2>
        </a>
        <p>Python을 공부하며 정리한 주제별 시리즈와 에피소드입니다.</p>
      </li>
    </ul>
  </Main>

  <Footer />
</Layout>
